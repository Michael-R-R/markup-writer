QTextEdit {
    border: 0px;
}

QTabBar::tab 
{
	border-style: solid;
	border-width: 1px;
	padding: 5px;
	padding-left: 15px;
	padding-right: 15px;
}

QTabBar::tab:!selected
{
	border-bottom-style: solid;
    margin-top: 2px;
}

QTabBar::tab:selected
{
    margin-left: -4px;
    margin-right: -4px;
	margin-bottom: 0px;
}

QTabBar::tab:first:selected
{
    margin-left: 0;
}

QTabBar::tab:last
{
	margin-right: 0; 
}

QTabBar::tab:only-one
{
    margin: 0;
}

QTabBar::tab:first
{
    border-top-left-radius: 10px;
}

QTabBar::tab:last
{
    border-top-right-radius: 10px;
}

QTabBar::tab:only-one
{
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}